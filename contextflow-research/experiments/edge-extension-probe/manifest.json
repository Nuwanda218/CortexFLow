{
  "manifest_version": 3,
  "name": "ContextFlow Edge Probe",
  "version": "0.1.0",
  "description": "Research probe: detect ChatGPT/mock-chat sessions, observe SPA navigation and streaming state, bridge to a local ContextFlow Core.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "scripting",
    "alarms",
    "sidePanel",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ContextFlow Edge Probe",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
