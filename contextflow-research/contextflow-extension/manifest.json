{
  "manifest_version": 3,
  "name": "ContextFlow ChatGPT Adapter",
  "version": "0.6.0",
  "description": "ChatGPT web adapter: session/message read, manual paper-plane submission, and verified reverse send.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["bridge_relay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ContextFlow ChatGPT Adapter"
  }
}
