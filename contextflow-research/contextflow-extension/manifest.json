{
  "manifest_version": 3,
  "name": "ContextFlow ChatGPT Adapter",
  "version": "0.7.0",
  "description": "ChatGPT Supervisor binding, marked instruction submission, and verified Core feedback.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "http://127.0.0.1/*"
      ],
      "js": ["runtime_config.js", "dispatch_protocol.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["bridge_relay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ContextFlow Supervisor",
    "default_popup": "popup.html"
  }
}
